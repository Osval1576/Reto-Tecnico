# Copia este archivo a backend/.env y ajusta los valores.

# Genera una con:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=cambia-esto

# True en local, False en producción
DEBUG=True

# Separados por comas, sin espacios
ALLOWED_HOSTS=127.0.0.1,localhost

# Solo producción: origen público con https
# CSRF_TRUSTED_ORIGINS=https://incidencias.onrender.com

# Opcional. Sin esta variable se usa SQLite (backend/db.sqlite3)
# DATABASE_URL=postgres://usuario:password@host:5432/incidencias
